// ------------------------------------------------------------
// Prism tile (from your existing code)
// ------------------------------------------------------------
typedef struct {
    float a0, a1, a2, a3;
} PrismTile;

// ------------------------------------------------------------
// Half‑sine descriptor
// ------------------------------------------------------------
typedef struct {
    int   direction;      // +1 = rising arc, -1 = falling arc
    int   prism_count;    // number of prisms in this half‑sine
    int   start_idx;      // index in the prism array
} HalfSine;

// ------------------------------------------------------------
// Full sine descriptor (two opposite half‑sines)
// ------------------------------------------------------------
typedef struct {
    int   prism_count;    // total prisms (2 × half_sine_count)
    int   start_idx;      // index in the prism array
} FullSine;

// ------------------------------------------------------------
// Run‑length encoded full sine
// ------------------------------------------------------------
typedef struct {
    uint64_t pattern_hash;   // hash of the full sine's coefficients
    int      repeat_count;   // how many consecutive identical full sines
    int      start_idx;      // index in the prism array
} RLESine;

