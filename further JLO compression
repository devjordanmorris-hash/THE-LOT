// Step 5: Combine half‑sines into full sines
int half_sines_to_full_sines(const HalfSine* half_sines, int n_half,
                             FullSine* out_full_sines);

// Step 6: Run‑length encode identical full sines
int full_sines_to_rle(const FullSine* full_sines, int n_full,
                      RLESine* out_rle);

// Convenience: full pipeline
